# ─── Node Identity ────────────────────────────────────────────────────────────
# Unique identifier for this node — shown in /api/v1/health response.
# Examples: pi-primary, office-standby, hetzner-vps-1
NODE_ID=pi-primary

# ─── Flask ────────────────────────────────────────────────────────────────────
FLASK_APP=app
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production

# ─── Database ─────────────────────────────────────────────────────────────────
# In dev: points to the postgres container (docker-compose.yml).
# In prod: points to the PostgreSQL Primary via Tailscale IP (100.x.x.x).
DATABASE_URL=postgresql://safe2gether:devpassword@postgres:5432/safe2gether
POSTGRES_PASSWORD=devpassword

# ─── Redis ────────────────────────────────────────────────────────────────────
# Always node-local — do not point this at another machine.
REDIS_URL=redis://redis:6379/0

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Must be identical on ALL nodes so tokens issued by one node are valid on others.
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# OAuth 2.0 Client ID from Google Cloud Console (used to verify id_tokens).
# Needed for Sign in with Google. Leave empty if not using Google auth.
GOOGLE_CLIENT_ID=

# ─── APNs (direkt, kein Firebase) ─────────────────────────────────────────────
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.safe2gether.app
APNS_KEY_PATH=/run/secrets/apns_key.p8
APNS_SANDBOX=true

# ─── SMS / OTP ────────────────────────────────────────────────────────────────
SMS_PROVIDER=
SMS_API_KEY=
SMS_FROM_NUMBER=

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Dev endpoint (dev.safe2gether.de) ───────────────────────────────────────
# Only needed when running docker-compose.dev-server.yml alongside prod.
# Do NOT reuse production SECRET_KEY / JWT_SECRET_KEY values here.
DEV_POSTGRES_PASSWORD=devpassword
DEV_SECRET_KEY=change-me-dev
DEV_JWT_SECRET_KEY=change-me-dev
DEV_CORS_ORIGINS=http://localhost:3000

# ─── Admin Dashboard ─────────────────────────────────────────────────────────
# Credentials for the /admin dashboard.
# ADMIN_PASSWORD: plaintext in dev; use a bcrypt hash ($2b$...) in production.
# Generate bcrypt hash: python -c "import bcrypt; print(bcrypt.hashpw(b'pw', bcrypt.gensalt()).decode())"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# ─── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Per-node token from Cloudflare Zero Trust dashboard.
# NEVER commit the real token — add .env to .gitignore.
# See docs/deployment/new-node.md for setup instructions.
CF_TUNNEL_TOKEN=
