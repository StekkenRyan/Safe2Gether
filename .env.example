# ─── Node Identity ────────────────────────────────────────────────────────────
# Unique identifier for this node — shown in /api/v1/health response.
# Examples: pi-primary, office-standby, hetzner-vps-1
NODE_ID=pi-primary

# ─── Flask ────────────────────────────────────────────────────────────────────
FLASK_APP=app
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production

# ─── Database ─────────────────────────────────────────────────────────────────
# In dev: points to the postgres container (docker-compose.yml).
# In prod: points to the PostgreSQL Primary via Tailscale IP (100.x.x.x).
DATABASE_URL=postgresql://safe2gether:devpassword@postgres:5432/safe2gether
POSTGRES_PASSWORD=devpassword

# ─── Redis ────────────────────────────────────────────────────────────────────
# Always node-local — do not point this at another machine.
REDIS_URL=redis://redis:6379/0

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Must be identical on ALL nodes so tokens issued by one node are valid on others.
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# ─── APNs (direkt, kein Firebase) ─────────────────────────────────────────────
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.safe2gether.app
APNS_KEY_PATH=/run/secrets/apns_key.p8
APNS_SANDBOX=true

# ─── SMS / OTP ────────────────────────────────────────────────────────────────
SMS_PROVIDER=
SMS_API_KEY=
SMS_FROM_NUMBER=

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Per-node token from Cloudflare Zero Trust dashboard.
# NEVER commit the real token — add .env to .gitignore.
# See docs/deployment/new-node.md for setup instructions.
CF_TUNNEL_TOKEN=
